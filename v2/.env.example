# =============================================================================
# WEB (apps/web) — todas estas variables van en el .env del proyecto Vercel.
# La mayoría tienen DEFAULTS bakeados con los valores reales heredados de v1,
# así que pueden dejarse vacías. Override solo si el valor cambia.
# =============================================================================

# Sitio público (usado por canonical, OG tags, sitemap)
PUBLIC_SITE_URL=https://carinjuryclinics.com

# Vacío = los /api/* viven en el mismo dominio (Vercel functions, recomendado).
PUBLIC_API_URL=

# -- /schedule — GoHighLevel calendar widget ----------------------------------
# Default bakeado: https://api.leadconnectorhq.com/widget/booking/CnL8Bv0AP9Fdqw6xYZji
# Override si cambias el calendario en GHL.
PUBLIC_BOOKING_URL=

# -- Form leads — webhook (LeadConnector / Make / Zapier) --------------------
# Default bakeado al endpoint GHL/LeadConnector de la clínica
# (services.leadconnectorhq.com/hooks/FrwO37FXAUYfoOh92uWG/...).
# Override solo si migras a Make.com o Zapier.
# Recibe POST JSON: { id, name, phone, email, message, language, ts, type? }
FORM_WEBHOOK_URL=

# -- Chat widget GHL (opcional) ----------------------------------------------
# Default bakeado: 69cc5bc9af4d3484b4c4f464. Para desactivar setea PUBLIC_GHL_WIDGET_ID=
PUBLIC_GHL_WIDGET_ID=

# -- Map embed (opcional, override del default Taylorsville UT) --------------
# Default bakeado a 2997 W 4700 S, Taylorsville, UT 84129.
PUBLIC_MAP_EMBED_URL=

# -- Analytics (opcional) -----------------------------------------------------
# Cualquiera vacía = ese tag no se carga. /gracias dispara conversion en todas
# las que estén activas via window.trackConversion('lead_submit').
PUBLIC_GA4_ID=
PUBLIC_META_PIXEL_ID=
PUBLIC_GOOGLE_ADS_ID=

# -- Email transactional (opcional, Resend) ----------------------------------
# Si vacía, no se manda email interno al equipo cuando llega un lead.
# El webhook a GHL sigue funcionando aunque esto esté vacío.
# Setup:
#   1. Cuenta en https://resend.com
#   2. Verifica el dominio en "Domains"
#   3. Crea API key, pégala aquí
RESEND_API_KEY=
LEAD_NOTIFY_TO=leads@carinjuryclinic.com
LEAD_FROM_EMAIL=leads@carinjuryclinic.com

# -- /api/reviews — Google Places (parcial) ----------------------------------
# Place ID ya bakeado (ChlJx3lYes5jUocR1NQ4jGHsye8). Solo falta la API key.
# Crea key en https://console.cloud.google.com (habilita "Places API").
# Sin key, /api/reviews devuelve la seed estática (6 reviews).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
PUBLIC_GOOGLE_PLACE_ID=

# =============================================================================
# API (apps/api) — SOLO si despliegas el back como servicio separado.
# Para Vercel Functions same-project, IGNORA estas.
# =============================================================================
API_PORT=3001
WEB_ORIGIN=http://localhost:4321
