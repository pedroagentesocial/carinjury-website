# ============================================================================
# Car Injury Clinic — Environment variables
# Copia este archivo a `.env` (o configura en Vercel) y rellena con tus IDs.
# ============================================================================

# --- Site ---
PUBLIC_SITE_URL=https://carinjuryclinics.com

# --- Google Search Console verification ---
# Pega el valor del meta tag que te da Google Search Console
# (Property → Verification → HTML tag method).
# Ej: PUBLIC_GOOGLE_SITE_VERIFICATION=abc123XYZ456...
PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Bing Webmaster Tools verification (opcional pero recomendado) ---
PUBLIC_BING_SITE_VERIFICATION=

# --- Google Analytics 4 ---
# Formato: G-XXXXXXXXXX
PUBLIC_GA4_ID=

# --- Google Ads ---
# Cuenta-level (sin "/conversion-id"). Formato: AW-XXXXXXXXXX
# Las conversiones se disparan automáticamente al enviar el form:
#   - 'contact_form_lead' (form de contacto del home / /form)
#   - 'patient_referral_lead' (form de patient referral)
# En Google Ads crea conversion actions con esos LABELS para trackear leads.
PUBLIC_GOOGLE_ADS_ID=AW-17106773139

# --- Meta Pixel (Facebook / Instagram Ads) ---
PUBLIC_META_PIXEL_ID=

# --- Google reCAPTCHA v2 ("I'm not a robot" Checkbox) ---
# Obtener en https://www.google.com/recaptcha/admin/create
# Tipo: reCAPTCHA v2 — "I'm not a robot" Checkbox
# Domains: carinjuryclinics.com (+ localhost para dev)
PUBLIC_RECAPTCHA_SITE_KEY=    # se inyecta en el client (visible)
RECAPTCHA_SECRET_KEY=          # se valida server-side (SECRETO)

# --- GHL / LeadConnector webhook (forward del form de contacto) ---
# Default ya está hardcoded en lead.ts; override si cambia el webhook
FORM_WEBHOOK_URL=

# --- Booking widget URL (override del default GHL) ---
PUBLIC_BOOKING_URL=

# --- Google Maps ---
PUBLIC_GOOGLE_PLACE_ID=
PUBLIC_MAP_EMBED_URL=
