---
import PageShell from '@layouts/PageShell.astro';
import CaseEvaluation from '@components/tools/CaseEvaluation';
import { Icon } from '@components/ui/Icon';
import { getAllCities } from '@lib/cities';
import { buildBreadcrumbSchema, buildMedicalWebPageSchema, absoluteUrl } from '@lib/seo';

export const prerender = true;

const locale = 'es' as const;
const url = '/herramientas/tengo-un-caso';
const alternateUrl = absoluteUrl('/en/tools/do-i-have-a-case');

const title = '¿Tengo un caso? · Evaluación gratuita de tu accidente | Car Injury Clinic';
const description =
  'Responde unas preguntas y descubre si vale la pena que un profesional revise tu caso de accidente en Utah — sin costo. Orientación educativa, no asesoría legal ni montos.';

/* WebPage + Breadcrumb únicamente — NADA que implique precio o resultado. */
const webPage = buildMedicalWebPageSchema({
  url,
  name: title,
  description,
  specialty: 'Chiropractic',
  audience: 'Patient',
});
const breadcrumb = buildBreadcrumbSchema([
  { name: 'Inicio', url: '/' },
  { name: 'Herramientas', url: '/herramientas/tengo-un-caso' },
  { name: '¿Tengo un caso?', url },
]);

const cities = getAllCities();
const checklistHref = '/herramientas/que-hacer-despues-de-un-accidente';
const blogHref = '/blog/que-hacer-primeras-24-horas-accidente';
---

<PageShell
  title={title}
  description={description}
  ogImage={absoluteUrl('/images/medical-care.webp')}
  schemas={[webPage, breadcrumb]}
  alternateUrl={alternateUrl}
  fullBleed
>
  {/* ===== HERO ===== */}
  <header class="relative isolate overflow-hidden bg-deep pb-12 pt-28 text-white md:pb-16 md:pt-36">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="absolute -left-32 top-0 h-[40vmax] w-[40vmax] rounded-full bg-secondary/15 blur-3xl"></div>
      <div class="absolute -right-32 bottom-0 h-[36vmax] w-[36vmax] rounded-full bg-primary/30 blur-3xl"></div>
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-[0.06] [background-image:radial-gradient(rgba(255,255,255,0.6)_1px,transparent_1px)] [background-size:24px_24px]"></div>

    <div class="relative mx-auto max-w-2xl px-6">
      <nav class="text-xs font-semibold text-white/65" aria-label="Breadcrumb">
        <a href="/" class="transition hover:text-secondary">Inicio</a>
        <span class="mx-2 text-white/30">/</span>
        <span class="text-white/85">Herramientas</span>
      </nav>
      <span class="mt-5 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.04] px-3 py-1 text-[11px] font-bold uppercase tracking-[0.18em] text-white/80 backdrop-blur">
        <span class="h-1 w-1 rounded-full bg-secondary"></span>
        Orientación gratuita · Salt Lake City, UT
      </span>
      <h1 class="mt-4 font-heading text-3xl font-extrabold leading-[1.1] tracking-tight sm:text-4xl md:text-[2.7rem]">
        ¿Tengo un caso después de mi accidente?
      </h1>
      <p class="mt-4 max-w-xl text-base leading-relaxed text-white/90 md:text-lg">
        Responde unas preguntas rápidas y te orientamos sobre si vale la pena que un profesional revise tu caso,
        sin costo. Es información educativa y empática — no es asesoría legal, no damos montos ni prometemos
        resultados.
      </p>
    </div>
  </header>

  {/* ===== HERRAMIENTA (island) ===== */}
  <div class="bg-white">
    <CaseEvaluation locale={locale} client:visible />
  </div>

  {/* ===== Enlazado interno ===== */}
  <section class="border-t border-line bg-surface-2 py-12 md:py-14">
    <div class="mx-auto max-w-2xl px-6">
      <h2 class="font-heading text-lg font-bold text-ink">Mientras tanto</h2>
      <div class="mt-4 grid gap-3">
        <a href={checklistHref} class="group flex items-center gap-3 rounded-2xl border border-line bg-white p-4 transition hover:border-primary/30 hover:shadow-sm">
          <span class="inline-flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-primary/[0.08] text-primary"><Icon name="check" size={18} /></span>
          <span class="flex-1 text-sm font-semibold text-ink">Checklist: qué hacer después de un accidente</span>
          <Icon name="arrow-right" size={16} className="text-primary/50 transition group-hover:translate-x-1" />
        </a>
        <a href={blogHref} class="group flex items-center gap-3 rounded-2xl border border-line bg-white p-4 transition hover:border-primary/30 hover:shadow-sm">
          <span class="inline-flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-primary/[0.08] text-primary"><Icon name="help" size={18} /></span>
          <span class="flex-1 text-sm font-semibold text-ink">Qué hacer en las primeras 24 horas tras un accidente</span>
          <Icon name="arrow-right" size={16} className="text-primary/50 transition group-hover:translate-x-1" />
        </a>
        <a href="/locations" class="group flex items-center gap-3 rounded-2xl border border-line bg-white p-4 transition hover:border-primary/30 hover:shadow-sm">
          <span class="inline-flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-primary/[0.08] text-primary"><Icon name="pin" size={18} /></span>
          <span class="flex-1 text-sm font-semibold text-ink">Atención cerca de ti en el condado de Salt Lake</span>
          <Icon name="arrow-right" size={16} className="text-primary/50 transition group-hover:translate-x-1" />
        </a>
      </div>
      <div class="mt-3 flex flex-wrap gap-2">
        {cities.map((city) => (
          <a href={`/locations/${city.slug}`} class="inline-flex items-center gap-1.5 rounded-full border border-primary/20 px-3.5 py-1.5 text-xs font-semibold text-primary transition hover:bg-primary/[0.06]">
            <Icon name="pin" size={13} />
            {city.name}
          </a>
        ))}
      </div>
    </div>
  </section>
</PageShell>
