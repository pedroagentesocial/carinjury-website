---
import PageShell from '@layouts/PageShell.astro';
import AccidentChecklist from '@components/tools/AccidentChecklist';
import { Icon } from '@components/ui/Icon';
import { SITE } from '@lib/site';
import { getAllCities } from '@lib/cities';
import { checklistSteps } from '@lib/tools/accident-checklist';
import { buildHowToSchema, buildBreadcrumbSchema, absoluteUrl } from '@lib/seo';

export const prerender = true;

const locale = 'en' as const;
const url = '/en/tools/what-to-do-after-a-car-accident';
const alternateUrl = absoluteUrl('/herramientas/que-hacer-despues-de-un-accidente');

const title = 'What to Do After a Car Accident in Utah · Checklist | Car Injury Clinic';
const description =
  'Step-by-step interactive checklist of what to do after a car accident in Utah: safety, 911, documenting, insurance and medical care. Save your progress and download the PDF.';

const howTo = buildHowToSchema({
  name: 'What to do after a car accident in Utah',
  description:
    'Step-by-step guide for the first moments after a car accident: get to safety, call 911, document, exchange information, get medical attention and book an evaluation.',
  steps: checklistSteps('en'),
});
const breadcrumb = buildBreadcrumbSchema([
  { name: 'Home', url: '/en/' },
  { name: 'Tools', url: '/en/tools/what-to-do-after-a-car-accident' },
  { name: 'What to do after a car accident', url },
]);

const cities = getAllCities();
const blogHref = '/en/blog/what-to-do-first-24-hours-after-accident';
const whatsappHref = '/api/whatsapp?lang=en';
---

<PageShell
  title={title}
  description={description}
  ogImage={absoluteUrl('/images/medical-care.webp')}
  schemas={[howTo, breadcrumb]}
  alternateUrl={alternateUrl}
  fullBleed
>
  {/* ===== HERO ===== */}
  <header class="relative isolate overflow-hidden bg-deep pb-12 pt-28 text-white md:pb-16 md:pt-36">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="absolute -left-32 top-0 h-[40vmax] w-[40vmax] rounded-full bg-secondary/15 blur-3xl"></div>
      <div class="absolute -right-32 bottom-0 h-[36vmax] w-[36vmax] rounded-full bg-primary/30 blur-3xl"></div>
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-[0.06] [background-image:radial-gradient(rgba(255,255,255,0.6)_1px,transparent_1px)] [background-size:24px_24px]"></div>

    <div class="relative mx-auto max-w-3xl px-6">
      <nav class="text-xs font-semibold text-white/65" aria-label="Breadcrumb">
        <a href="/en/" class="transition hover:text-secondary">Home</a>
        <span class="mx-2 text-white/30">/</span>
        <span class="text-white/85">Tools</span>
      </nav>
      <span class="mt-5 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.04] px-3 py-1 text-[11px] font-bold uppercase tracking-[0.18em] text-white/80 backdrop-blur">
        <span class="h-1 w-1 rounded-full bg-secondary"></span>
        Free guide · Salt Lake City, UT
      </span>
      <h1 class="mt-4 font-heading text-3xl font-extrabold leading-[1.1] tracking-tight sm:text-4xl md:text-[2.7rem]">
        What to do after a car accident
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-white/90 md:text-lg">
        A step-by-step checklist for the first moments after a crash in Utah. Check off each step, save your
        progress, and download it or share it with your family. This is educational and informational, not legal advice.
      </p>
    </div>
  </header>

  {/* ===== TOOL (island) ===== */}
  <div class="bg-white">
    <AccidentChecklist locale={locale} client:visible />
  </div>

  {/* ===== CLOSING CTA ===== */}
  <section class="bg-surface-2 py-14 md:py-16">
    <div class="mx-auto max-w-3xl px-6">
      <div class="rounded-3xl border border-line bg-white p-7 text-center shadow-sm md:p-10">
        <h2 class="font-heading text-2xl font-extrabold text-ink md:text-3xl">Had an accident? Call us now</h2>
        <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-muted">
          Same-day evaluation, in Spanish or English, with free transportation and legal guidance if you need it.
          No cost, no obligation.
        </p>
        <div class="mt-7 flex flex-wrap justify-center gap-3">
          <a href={`tel:${SITE.phone.tel}`} class="btn-uiverse-primary inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-semibold">
            <Icon name="phone" size={16} />
            {SITE.phone.display}
          </a>
          <a href={whatsappHref} rel="nofollow" class="inline-flex items-center gap-2 rounded-full bg-[#25D366] px-6 py-3 text-sm font-semibold text-[#0b3d24] transition hover:brightness-105">
            <Icon name="whatsapp" size={18} />
            WhatsApp
          </a>
          <a href="/en/schedule" class="inline-flex items-center gap-2 rounded-full border border-primary/25 px-6 py-3 text-sm font-semibold text-primary transition hover:bg-primary/[0.06]">
            <Icon name="calendar" size={16} />
            Schedule
          </a>
        </div>
      </div>

      {/* ===== Internal links ===== */}
      <div class="mt-10">
        <h2 class="font-heading text-lg font-bold text-ink">Keep reading</h2>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          <a href={blogHref} class="group flex items-center gap-3 rounded-2xl border border-line bg-white p-4 transition hover:border-primary/30 hover:shadow-sm">
            <span class="inline-flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-primary/[0.08] text-primary"><Icon name="help" size={18} /></span>
            <span class="flex-1 text-sm font-semibold text-ink">What to do in the first 24 hours after an accident</span>
            <Icon name="arrow-right" size={16} className="text-primary/50 transition group-hover:translate-x-1" />
          </a>
          <a href="/en/locations" class="group flex items-center gap-3 rounded-2xl border border-line bg-white p-4 transition hover:border-primary/30 hover:shadow-sm">
            <span class="inline-flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-primary/[0.08] text-primary"><Icon name="pin" size={18} /></span>
            <span class="flex-1 text-sm font-semibold text-ink">Care near you across Salt Lake County</span>
            <Icon name="arrow-right" size={16} className="text-primary/50 transition group-hover:translate-x-1" />
          </a>
        </div>
        <div class="mt-3 flex flex-wrap gap-2">
          {cities.map((city) => (
            <a href={`/en/locations/${city.slug}`} class="inline-flex items-center gap-1.5 rounded-full border border-primary/20 px-3.5 py-1.5 text-xs font-semibold text-primary transition hover:bg-primary/[0.06]">
              <Icon name="pin" size={13} />
              {city.name}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</PageShell>
