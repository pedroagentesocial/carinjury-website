---
import type { Locale } from '@carinjury/shared';
import { SITE, SEARCH_CONSOLE_VERIFICATION, BING_VERIFICATION } from '@lib/site';
import {
  buildLocalBusinessSchema,
  buildWebSiteSchema,
  buildOrganizationSchema,
  buildBreadcrumbSchema,
  absoluteUrl,
} from '@lib/seo';
import { getReviews } from '@/lib/server/reviews';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Comma-separated keywords (Bing + auditors). */
  keywords?: string;
  /** Tipo OG. */
  ogType?: 'website' | 'article';
  /** Imagen OG. Si no se pasa, usa /og-default.svg */
  image?: string;
  /** Canonical absoluto. Si no se pasa, lo construye desde Astro.url */
  canonical?: string;
  /**
   * URL absoluta de la versión en el otro idioma (hreflang alternate).
   * Necesaria cuando el slug difiere entre idiomas (ej. blog), donde el
   * intercambio automático de path daría una URL incorrecta.
   */
  alternateUrl?: string;
  /** Sitio: si es página principal mostramos schemas globales (LocalBusiness, WebSite, Organization). */
  isHome?: boolean;
  /** Schemas extra (FAQ, Breadcrumb, etc.) específicos de la página. */
  schemas?: unknown[];
}

const {
  locale,
  title,
  description,
  keywords,
  ogType = 'website',
  image,
  canonical,
  alternateUrl,
  isHome = false,
  schemas = [],
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? SITE.url;
const currentPath = Astro.url.pathname;
const canonicalUrl = canonical ?? new URL(currentPath, siteUrl).toString();
const ogImageUrl = absoluteUrl(image ?? '/og-default.svg', siteUrl);

/* hreflang ES <-> EN + x-default */
const altLocale: Locale = locale === 'es' ? 'en' : 'es';
const altPath =
  altLocale === 'en'
    ? currentPath.startsWith('/en')
      ? currentPath
      : `/en${currentPath}`
    : currentPath.startsWith('/en')
      ? currentPath.replace(/^\/en/, '') || '/'
      : currentPath;
const altUrl = alternateUrl ?? new URL(altPath, siteUrl).toString();

/*
 * Global schemas — solo en home (isHome). Para AggregateRating + reviews,
 * tiramos del cache server-side (6h TTL) que fetcha Google Places API si
 * GOOGLE_PLACES_API_KEY/GOOGLE_PLACE_ID están seteadas, con fallback a SEED.
 * Si el fetch falla por cualquier motivo, no emitimos rating (mejor sin
 * snippet que con datos incorrectos).
 */
let reviewsData: Awaited<ReturnType<typeof getReviews>> | null = null;
if (isHome) {
  try {
    reviewsData = await getReviews();
  } catch (err) {
    console.error('[SiteMeta] reviews fetch failed', err);
  }
}

const globalSchemas = isHome
  ? [
      buildLocalBusinessSchema({
        ogImage: ogImageUrl,
        locale,
        aggregateRating: reviewsData
          ? { value: reviewsData.average, count: reviewsData.reviews.length }
          : undefined,
        reviews: reviewsData
          ? reviewsData.reviews.slice(0, 5).map((r) => ({
              author: r.author,
              rating: r.rating,
              text: locale === 'en' ? r.text_en : r.text_es,
              date: r.date,
            }))
          : undefined,
      }),
      buildWebSiteSchema(),
      buildOrganizationSchema(ogImageUrl),
      buildBreadcrumbSchema([
        { name: locale === 'en' ? 'Home' : 'Inicio', url: locale === 'en' ? '/en/' : '/' },
      ]),
    ]
  : [];

const allSchemas = [...globalSchemas, ...schemas];
---

<!-- Primary meta -->
<title>{title}</title>
<meta name="description" content={description} />
{keywords && <meta name="keywords" content={keywords} />}
<meta name="author" content={SITE.name} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<link rel="canonical" href={canonicalUrl} />

<!-- Geo meta (local SEO) -->
<meta name="geo.region" content="US-UT" />
<meta name="geo.placename" content={`${SITE.address.city}, ${SITE.address.region}`} />
<meta name="geo.position" content={`${SITE.address.geo.lat};${SITE.address.geo.lng}`} />
<meta name="ICBM" content={`${SITE.address.geo.lat}, ${SITE.address.geo.lng}`} />

<!-- Verificaciones (vacío si la env var no está set) -->
{SEARCH_CONSOLE_VERIFICATION && <meta name="google-site-verification" content={SEARCH_CONSOLE_VERIFICATION} />}
{BING_VERIFICATION && <meta name="msvalidate.01" content={BING_VERIFICATION} />}

<!-- hreflang -->
<link rel="alternate" hreflang={locale} href={canonicalUrl} />
<link rel="alternate" hreflang={altLocale} href={altUrl} />
<link rel="alternate" hreflang="x-default" href={siteUrl} />

<!-- Open Graph -->
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={locale === 'es' ? 'es_US' : 'en_US'} />
<meta property="og:locale:alternate" content={altLocale === 'es' ? 'es_US' : 'en_US'} />
<meta property="og:site_name" content={SITE.name} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Theme -->
<meta name="theme-color" content="#4a1c5a" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="format-detection" content="telephone=yes" />

<!-- JSON-LD: schemas combinados (LocalBusiness, WebSite, Organization en home + extras de la page) -->
{allSchemas.map((s) => (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />
))}
