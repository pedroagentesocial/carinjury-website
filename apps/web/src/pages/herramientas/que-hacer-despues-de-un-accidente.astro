---
import PageShell from '@layouts/PageShell.astro';
import AccidentChecklist from '@components/tools/AccidentChecklist';
import { Icon } from '@components/ui/Icon';
import { SITE } from '@lib/site';
import { getAllCities } from '@lib/cities';
import { checklistSteps } from '@lib/tools/accident-checklist';
import { buildHowToSchema, buildBreadcrumbSchema, absoluteUrl } from '@lib/seo';

export const prerender = true;

const locale = 'es' as const;
const url = '/herramientas/que-hacer-despues-de-un-accidente';
const alternateUrl = absoluteUrl('/en/tools/what-to-do-after-a-car-accident');

const title = 'Qué hacer después de un accidente de auto en Utah · Checklist | Car Injury Clinic';
const description =
  'Checklist interactivo paso a paso de qué hacer tras un accidente de auto en Utah: seguridad, 911, documentar, seguro y atención médica. Guarda tu progreso y descárgalo en PDF.';

const howTo = buildHowToSchema({
  name: 'Qué hacer después de un accidente de auto en Utah',
  description:
    'Guía paso a paso para los primeros momentos tras un accidente de auto: ponerte a salvo, llamar al 911, documentar, intercambiar datos, buscar atención médica y agendar una evaluación.',
  steps: checklistSteps('es'),
});
const breadcrumb = buildBreadcrumbSchema([
  { name: 'Inicio', url: '/' },
  { name: 'Herramientas', url: '/herramientas' },
  { name: 'Qué hacer después de un accidente', url },
]);

const cities = getAllCities();
const blogHref = '/blog/que-hacer-primeras-24-horas-accidente';
const whatsappHref = '/api/whatsapp?lang=es';
---

<PageShell
  title={title}
  description={description}
  ogImage={absoluteUrl('/images/medical-care.webp')}
  schemas={[howTo, breadcrumb]}
  alternateUrl={alternateUrl}
  fullBleed
>
  {/* ===== HERO ===== */}
  <header class="relative isolate overflow-hidden bg-deep pb-12 pt-28 text-white md:pb-16 md:pt-36">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="absolute -left-32 top-0 h-[40vmax] w-[40vmax] rounded-full bg-secondary/15 blur-3xl"></div>
      <div class="absolute -right-32 bottom-0 h-[36vmax] w-[36vmax] rounded-full bg-primary/30 blur-3xl"></div>
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 opacity-[0.06] [background-image:radial-gradient(rgba(255,255,255,0.6)_1px,transparent_1px)] [background-size:24px_24px]"></div>

    <div class="relative mx-auto max-w-3xl px-6">
      <nav class="text-xs font-semibold text-white/65" aria-label="Breadcrumb">
        <a href="/" class="transition hover:text-secondary">Inicio</a>
        <span class="mx-2 text-white/30">/</span>
        <a href="/herramientas" class="transition hover:text-secondary">Herramientas</a>
      </nav>
      <span class="mt-5 inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/[0.04] px-3 py-1 text-[11px] font-bold uppercase tracking-[0.18em] text-white/80 backdrop-blur">
        <span class="h-1 w-1 rounded-full bg-secondary"></span>
        Guía gratuita · Salt Lake City, UT
      </span>
      <h1 class="mt-4 font-heading text-3xl font-extrabold leading-[1.1] tracking-tight sm:text-4xl md:text-[2.7rem]">
        ¿Qué hacer después de un accidente de auto?
      </h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-white/90 md:text-lg">
        Un checklist paso a paso para los primeros momentos tras un choque en Utah. Marca cada paso, guarda tu
        progreso y descárgalo o compártelo con tu familia. Es información educativa y de orientación, no asesoría legal.
      </p>
    </div>
  </header>

  {/* ===== HERRAMIENTA (island) ===== */}
  <div class="bg-white">
    <AccidentChecklist locale={locale} client:visible />
  </div>

  {/* ===== CTA DE CIERRE ===== */}
  <section class="bg-surface-2 py-14 md:py-16">
    <div class="mx-auto max-w-3xl px-6">
      <div class="rounded-3xl border border-line bg-white p-7 text-center shadow-sm md:p-10">
        <h2 class="font-heading text-2xl font-extrabold text-ink md:text-3xl">¿Tuviste un accidente? Llámanos ahora</h2>
        <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-muted">
          Evaluación el mismo día, en español o inglés, con transporte gratis y orientación legal si la necesitas.
          Sin costo y sin compromiso.
        </p>
        <div class="mt-7 flex flex-wrap justify-center gap-3">
          <a href={`tel:${SITE.phone.tel}`} class="btn-uiverse-primary inline-flex items-center gap-2 rounded-full px-6 py-3 text-sm font-semibold">
            <Icon name="phone" size={16} />
            {SITE.phone.display}
          </a>
          <a href={whatsappHref} rel="nofollow" class="inline-flex items-center gap-2 rounded-full bg-[#25D366] px-6 py-3 text-sm font-semibold text-[#0b3d24] transition hover:brightness-105">
            <Icon name="whatsapp" size={18} />
            WhatsApp
          </a>
          <a href="/schedule" class="inline-flex items-center gap-2 rounded-full border border-primary/25 px-6 py-3 text-sm font-semibold text-primary transition hover:bg-primary/[0.06]">
            <Icon name="calendar" size={16} />
            Agendar
          </a>
        </div>
      </div>

      {/* ===== Enlazado interno ===== */}
      <div class="mt-10">
        <h2 class="font-heading text-lg font-bold text-ink">Sigue informándote</h2>
        <div class="mt-4 grid gap-3 sm:grid-cols-2">
          <a href={blogHref} class="group flex items-center gap-3 rounded-2xl border border-line bg-white p-4 transition hover:border-primary/30 hover:shadow-sm">
            <span class="inline-flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-primary/[0.08] text-primary"><Icon name="help" size={18} /></span>
            <span class="flex-1 text-sm font-semibold text-ink">Qué hacer en las primeras 24 horas tras un accidente</span>
            <Icon name="arrow-right" size={16} className="text-primary/50 transition group-hover:translate-x-1" />
          </a>
          <a href="/locations" class="group flex items-center gap-3 rounded-2xl border border-line bg-white p-4 transition hover:border-primary/30 hover:shadow-sm">
            <span class="inline-flex h-10 w-10 flex-none items-center justify-center rounded-xl bg-primary/[0.08] text-primary"><Icon name="pin" size={18} /></span>
            <span class="flex-1 text-sm font-semibold text-ink">Atención cerca de ti en el condado de Salt Lake</span>
            <Icon name="arrow-right" size={16} className="text-primary/50 transition group-hover:translate-x-1" />
          </a>
        </div>
        <div class="mt-3 flex flex-wrap gap-2">
          {cities.map((city) => (
            <a href={`/locations/${city.slug}`} class="inline-flex items-center gap-1.5 rounded-full border border-primary/20 px-3.5 py-1.5 text-xs font-semibold text-primary transition hover:bg-primary/[0.06]">
              <Icon name="pin" size={13} />
              {city.name}
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</PageShell>
